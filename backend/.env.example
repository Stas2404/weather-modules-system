PROJECT_NAME="Система обліку впливу погодних умов на вимірювальні модулі"
API_V1_PREFIX="/api/v1"

DATABASE_URL="postgresql+asyncpg://weather_user:weather_pass@db:5432/weather_db"
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_pass
POSTGRES_DB=weather_db

SECRET_KEY="super-secret-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ключ для Google Gemini API (якщо залишити порожнім — спрацює коректний fallback/error log)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Початковий адміністратор (створюється автоматично при старті)
FIRST_ADMIN_EMAIL="admin@nure.ua"
FIRST_ADMIN_PASSWORD="AdminPassword123!"